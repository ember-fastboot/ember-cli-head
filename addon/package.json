{
  "name": "ember-cli-head",
  "version": "2.0.0",
  "description": "An addon to easily set document head content via a template.",
  "keywords": [
    "ember-addon",
    "meta",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ronco/ember-cli-head.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "declarations"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "prepublishOnly": "rollup --config",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "glint",
    "start": "rollup --config --watch"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.2",
    "@glimmer/component": "^2.0.0",
    "decorator-transforms": "^2.2.2",
    "ember-in-element-polyfill": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-typescript": "^7.25.2",
    "@babel/runtime": "^7.25.6",
    "@ember/library-tsconfig": "^1.1.3",
    "@embroider/addon-dev": "^8.2.0",
    "@eslint/js": "^9.39.2",
    "@glint/core": "^1.4.0",
    "@glint/environment-ember-template-imports": "^1.4.0",
    "@glint/template": "^1.4.0",
    "@rollup/plugin-babel": "^6.1.0",
    "babel-plugin-ember-template-compilation": "^2.2.5",
    "concurrently": "^9.1.2",
    "ember-source": "^5.4.0",
    "ember-template-lint": "^6.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^12.3.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.15.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "rollup": "^4.54.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.50.1"
  },
  "engines": {
    "node": "12.* || 14.* || 16.* || >= 18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2,
    "app-js": {
      "./components/head-layout.js": "./dist/_app_/components/head-layout.js",
      "./components/head-layout.js.map": "./dist/_app_/components/head-layout.js.map"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  }
}
