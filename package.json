{
  "name": "ember-cli-head",
  "version": "2.0.0",
  "description": "An addon to easily set document head content via a template.",
  "keywords": [
    "ember-addon",
    "meta",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ronco/ember-cli-head.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "ember-compatibility-tests": "ember try:each"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-htmlbars": "^7.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@embroider/macros": "^1.20.6",
    "@embroider/test-setup": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "broccoli-asset-rev": "^3.0.0",
    "chai": "^4.2.0",
    "concurrently": "^9.2.4",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.2.0",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-cli-fastboot": "^5.0.3",
    "ember-cli-fastboot-testing": "^0.6.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^3.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.2.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-imports": "^4.4.0",
    "ember-template-lint": "^6.1.0",
    "ember-try": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^15.15.0",
    "loader.js": "^4.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.7",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "release-plan": "^0.5.1",
    "webpack": "^5.109.2"
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  },
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af"
}
